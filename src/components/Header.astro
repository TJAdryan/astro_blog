---
import HeaderLink from "./HeaderLink.astro";
import HolidayToggle from "./HolidayToggle.astro";
---

<header class="site-header">
	<nav class="header-nav" aria-label="Primary navigation">
		<div class="site-branding">
			<button
				id="logo-trigger"
				type="button"
				class="site-logo-btn"
				aria-label="Enlarge logo"
				title="Click to enlarge"
			>
				<img
					src="/img/tosvg.svg"
					alt="NextValData logo"
					class="site-logo"
					width="68"
					height="68"
				/>
			</button>
			<a href="/" class="site-title-link">
				<span class="site-title-text"
					><strong>Next <span class="accent">Val</span> Data</strong></span
				>
			</a>
		</div>

		<!-- Compact mobile/tablet controls (< 1024px) -->
		<div class="mobile-controls">
			<a
				href="/q-train"
				class="mobile-q-shortcut"
				aria-label="BMT Brighton Line Status"
				title="BMT Brighton Line Status"
			>
				<span class="mta-bullet q-bullet">Q</span>
			</a>
			<button
				id="mobile-menu-toggle"
				type="button"
				class="menu-toggle-btn"
				aria-expanded="false"
				aria-controls="site-nav-menu"
				aria-label="Toggle navigation menu"
			>
				<svg
					class="menu-icon-open"
					viewBox="0 0 24 24"
					width="24"
					height="24"
					fill="none"
					stroke="currentColor"
					stroke-width="2.2"
					stroke-linecap="round"
					aria-hidden="true"
				>
					<line x1="3" y1="6" x2="21" y2="6"></line>
					<line x1="3" y1="12" x2="21" y2="12"></line>
					<line x1="3" y1="18" x2="21" y2="18"></line>
				</svg>
				<svg
					class="menu-icon-close"
					viewBox="0 0 24 24"
					width="24"
					height="24"
					fill="none"
					stroke="currentColor"
					stroke-width="2.2"
					stroke-linecap="round"
					aria-hidden="true"
				>
					<line x1="6" y1="6" x2="18" y2="18"></line>
					<line x1="18" y1="6" x2="6" y2="18"></line>
				</svg>
			</button>
		</div>

		<!-- Unified nav menu: horizontal bar on desktop (>= 1024px), collapsible drawer below -->
		<div id="site-nav-menu" class="nav-menu">
			<div class="internal-links">
				<HeaderLink href="/">Home</HeaderLink>
				<HeaderLink href="/blog">Posts</HeaderLink>
				<HeaderLink href="/interesting-articles">Reading List</HeaderLink>
				<HeaderLink href="/interactive">Interactive</HeaderLink>
				<HeaderLink href="/about">About</HeaderLink>
				<HeaderLink href="/contact">Contact</HeaderLink>
				<HeaderLink
					href="/q-train"
					class="q-nav-link"
					aria-label="BMT Brighton Line Status"
					title="BMT Brighton Line Status"
				>
					<span class="mta-bullet q-bullet">
						Q
						<svg
							class="q-santa-cap"
							viewBox="0 0 120 100"
							fill="none"
							xmlns="http://www.w3.org/2000/svg"
							aria-hidden="true"
						>
							<defs>
								<linearGradient id="q-santa-red" x1="15" y1="10" x2="95" y2="75" gradientUnits="userSpaceOnUse">
									<stop offset="0%" stop-color="#ef233c" />
									<stop offset="55%" stop-color="#d90429" />
									<stop offset="100%" stop-color="#8d0801" />
								</linearGradient>
								<linearGradient id="q-santa-brim" x1="10" y1="45" x2="80" y2="85" gradientUnits="userSpaceOnUse">
									<stop offset="0%" stop-color="#ffffff" />
									<stop offset="75%" stop-color="#f8fafc" />
									<stop offset="100%" stop-color="#cbd5e1" />
								</linearGradient>
							</defs>
							<path
								d="M18 52 C22 18, 56 6, 84 20 C98 27, 105 44, 102 64 C96 58, 89 48, 80 45 C72 42, 74 58, 76 66 Z"
								fill="url(#q-santa-red)"
							/>
							<path
								d="M8 50 C6 42, 16 38, 26 41 C34 38, 46 41, 56 46 C66 49, 78 55, 84 64 C88 71, 82 80, 72 79 C62 78, 52 74, 40 69 C28 64, 16 61, 10 56 C7 54, 8 52, 8 50 Z"
								fill="url(#q-santa-brim)"
							/>
							<circle cx="101" cy="69" r="14" fill="#ffffff" />
						</svg>
					</span>
					<span class="mobile-only-label">Brighton Line Status</span>
				</HeaderLink>
				<HolidayToggle />
			</div>

			<div class="social-links">
				<a
					href="https://mastodon.social/@tjadomryan"
					target="_blank"
					rel="noopener noreferrer"
					title="Mastodon"
				>
					<span class="sr-only">Follow TJAdryan on Mastodon</span>
					<svg viewBox="0 0 16 16" aria-hidden="true" width="24" height="24">
						<path
							fill="currentColor"
							d="M11.19 12.195c2.016-.24 3.77-1.475 3.99-2.603.348-1.778.32-4.339.32-4.339 0-3.47-2.286-4.488-2.286-4.488C12.062.238 10.083.017 8.027 0h-.05C5.92.017 3.942.238 2.79.765c0 0-2.285 1.017-2.285 4.488l-.002.662c-.004.64-.007 1.35.011 2.091.083 3.394.626 6.74 3.78 7.57 1.454.383 2.703.463 3.709.408 1.823-.1 2.847-.647 2.847-.647l-.06-1.317s-1.303.41-2.767.36c-1.45-.05-2.98-.156-3.215-1.928a3.614 3.614 0 0 1-.033-.496s1.424.346 3.228.428c1.103.05 2.137-.064 3.188-.189zm1.613-2.47H11.13v-4.08c0-.859-.364-1.295-1.091-1.295-.804 0-1.207.517-1.207 1.541v2.233H7.168V5.89c0-1.024-.403-1.541-1.207-1.541-.727 0-1.091.436-1.091 1.296v4.079H3.197V5.522c0-.859.22-1.541.66-2.046.456-.505 1.052-.764 1.793-.764.856 0 1.504.328 1.933.983L8 4.39l.417-.695c.429-.655 1.077-.983 1.934-.983.74 0 1.336.259 1.791.764.442.505.661 1.187.661 2.046v4.203z"
						></path>
					</svg>
				</a>
				<a
					href="https://adl.org"
					target="_blank"
					rel="noopener noreferrer"
					class="disabled-link"
					title="Not on Twitter (links to ADL)"
				>
					<span class="sr-only">Not on Twitter</span>
					<div style="position: relative; display: inline-flex;">
						<svg
							viewBox="0 0 16 16"
							aria-hidden="true"
							width="24"
							height="24"
							style="opacity: 0.4;"
						>
							<path
								fill="currentColor"
								d="M5.026 15c6.038 0 9.341-5.003 9.341-9.334 0-.14 0-.282-.006-.422A6.685 6.685 0 0 0 16 3.542a6.658 6.658 0 0 1-1.889.518 3.301 3.301 0 0 0 1.447-1.817 6.533 6.533 0 0 1-2.087.793A3.286 3.286 0 0 0 7.875 6.03a9.325 9.325 0 0 1-6.767-3.429 3.289 3.289 0 0 0 1.018 4.382A3.323 3.323 0 0 1 .64 6.575v.045a3.288 3.288 0 0 0 2.632 3.218 3.203 3.203 0 0 1-.865.115 3.23 3.23 0 0 1-.614-.057 3.283 3.283 0 0 0 3.067 2.277A6.588 6.588 0 0 1 .78 13.58a6.32 6.32 0 0 1-.78-.045A9.344 9.344 0 0 0 5.026 15z"
							></path>
						</svg>
						<svg
							viewBox="0 0 16 16"
							aria-hidden="true"
							width="24"
							height="24"
							style="position: absolute; top: 0; left: 0;"
						>
							<path
								fill="red"
								stroke="red"
								stroke-width="2"
								d="M2 2 L14 14 M14 2 L2 14"></path>
						</svg>
					</div>
				</a>
				<a
					href="https://github.com/tjadryan"
					target="_blank"
					rel="noopener noreferrer"
					title="GitHub"
				>
					<span class="sr-only">Go to TJAdryan's GitHub profile</span>
					<svg viewBox="0 0 16 16" aria-hidden="true" width="24" height="24">
						<path
							fill="currentColor"
							d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"
						></path>
					</svg>
				</a>
				<a href="/rss.xml" title="RSS Feed">
					<span class="sr-only">Subscribe via RSS</span>
					<svg viewBox="0 0 24 24" aria-hidden="true" width="22" height="22" fill="currentColor">
						<circle cx="6.18" cy="17.82" r="2.18"></circle>
						<path d="M4 4.44v2.83c7.03 0 12.73 5.7 12.73 12.73h2.83c0-8.59-6.97-15.56-15.56-15.56zm0 5.66v2.83c3.9 0 7.07 3.17 7.07 7.07h2.83c0-5.47-4.43-9.9-9.9-9.9z"></path>
					</svg>
				</a>
			</div>
		</div>
	</nav>

	<div class="holiday-fairy-lights" aria-hidden="true">
		<span class="light-bulb bulb-gold"></span>
		<span class="light-bulb bulb-cranberry"></span>
		<span class="light-bulb bulb-pine"></span>
		<span class="light-bulb bulb-ice"></span>
		<span class="light-bulb bulb-gold"></span>
		<span class="light-bulb bulb-cranberry"></span>
		<span class="light-bulb bulb-pine"></span>
		<span class="light-bulb bulb-ice"></span>
		<span class="light-bulb bulb-gold"></span>
		<span class="light-bulb bulb-cranberry"></span>
		<span class="light-bulb bulb-pine"></span>
		<span class="light-bulb bulb-ice"></span>
		<span class="light-bulb bulb-gold"></span>
		<span class="light-bulb bulb-cranberry"></span>
		<span class="light-bulb bulb-pine"></span>
		<span class="light-bulb bulb-ice"></span>
		<span class="light-bulb bulb-gold"></span>
		<span class="light-bulb bulb-cranberry"></span>
		<span class="light-bulb bulb-pine"></span>
		<span class="light-bulb bulb-ice"></span>
		<span class="light-bulb bulb-gold"></span>
		<span class="light-bulb bulb-cranberry"></span>
		<span class="light-bulb bulb-pine"></span>
		<span class="light-bulb bulb-ice"></span>
	</div>
</header>

<style>
	.site-header {
		position: relative;
		z-index: 40;
		margin: 0;
		padding: 0 1rem;
		background: white;
		box-shadow: 0 2px 8px rgba(var(--black), 5%);
		box-sizing: border-box;
		width: 100%;
	}

	.header-nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		max-width: 1400px;
		margin: 0 auto;
		min-height: 76px;
		box-sizing: border-box;
		width: 100%;
	}

	.site-branding {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		flex-shrink: 0;
	}

	.site-title-link {
		text-decoration: none;
		color: rgb(var(--black));
		display: inline-flex;
		align-items: center;
		padding: 0.25rem 0;
		border-bottom: none;
	}

	.site-title-link:hover {
		color: rgb(var(--black));
	}

	.site-logo-btn {
		background: none;
		border: none;
		padding: 0;
		cursor: zoom-in;
		display: flex;
		flex-shrink: 0;
		transition: transform 0.2s ease;
	}

	.site-logo-btn:hover {
		transform: scale(1.05);
	}

	.site-logo {
		width: 68px;
		height: 68px;
		display: block;
	}

	.site-title-text {
		font-size: clamp(1.35rem, 1.8vw, 1.85rem);
		line-height: 1;
		font-weight: 700;
		letter-spacing: -0.05em;
		white-space: nowrap;
	}

	.site-title-text .accent {
		color: var(--accent);
	}

	/* Desktop nav menu */
	.nav-menu {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.75rem;
		flex: 1 1 auto;
		min-width: 0;
	}

	.internal-links {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: clamp(0.15rem, 0.7vw, 0.65rem);
		flex: 1 1 auto;
		min-width: 0;
	}

	.internal-links :global(a) {
		display: inline-flex;
		align-items: center;
		padding: 0.75rem 0.5rem;
		color: rgb(var(--black));
		border-bottom: 3px solid transparent;
		text-decoration: none;
		white-space: nowrap;
		font-size: 0.96rem;
		font-weight: 500;
		transition: color 0.18s ease, border-color 0.18s ease;
	}

	.internal-links :global(a:hover) {
		color: var(--accent);
	}

	.internal-links :global(a.active) {
		font-weight: 700;
		text-decoration: none;
		border-bottom-color: var(--accent);
	}

	.mobile-only-label {
		display: none;
	}

	.social-links {
		display: flex;
		align-items: center;
		gap: 0.2rem;
		flex-shrink: 0;
	}

	.social-links a {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		padding: 0.45rem;
		color: rgb(var(--black));
		border-radius: 8px;
		border-bottom: none;
		text-decoration: none;
		transition: color 0.18s ease, background-color 0.18s ease;
	}

	.social-links a:hover {
		color: var(--accent);
		background: rgba(255, 107, 53, 0.08);
	}

	/* Compact mobile/tablet controls hidden on desktop */
	.mobile-controls {
		display: none;
		align-items: center;
		gap: 0.5rem;
		flex-shrink: 0;
	}

	.mobile-q-shortcut {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		padding: 0.35rem;
		text-decoration: none;
		border-radius: 9999px;
	}

	.menu-toggle-btn {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 42px;
		height: 42px;
		border: 1px solid rgba(15, 23, 42, 0.12);
		border-radius: 10px;
		background: #f8fafc;
		color: rgb(var(--black));
		cursor: pointer;
		transition: background-color 0.18s ease, border-color 0.18s ease, color 0.18s ease;
	}

	.menu-toggle-btn:hover {
		border-color: var(--accent);
		color: var(--accent);
		background: rgba(255, 107, 53, 0.06);
	}

	.menu-toggle-btn .menu-icon-close {
		display: none;
	}

	.menu-toggle-btn[aria-expanded="true"] .menu-icon-open {
		display: none;
	}

	.menu-toggle-btn[aria-expanded="true"] .menu-icon-close {
		display: block;
	}

	/* Medium desktop refinement (1024px - 1279px) */
	@media (max-width: 1279px) and (min-width: 1024px) {
		.site-logo {
			width: 54px;
			height: 54px;
		}
		.internal-links :global(a) {
			padding: 0.7rem 0.35rem;
			font-size: 0.9rem;
		}
		.social-links a {
			padding: 0.35rem;
		}
	}

	/* Tablet & Mobile collapsible drawer (< 1024px) */
	@media (max-width: 1023px) {
		.site-header {
			padding: 0 0.85rem;
		}

		.header-nav {
			flex-wrap: wrap;
			min-height: 64px;
			gap: 0.5rem;
		}

		.site-logo {
			width: 44px;
			height: 44px;
		}

		.site-title-text {
			font-size: 1.35rem;
		}

		.mobile-controls {
			display: flex;
		}

		.nav-menu {
			display: none;
			flex-direction: column;
			align-items: stretch;
			width: 100%;
			flex: 1 0 100%;
			padding: 0.5rem 0 1rem;
			border-top: 1px solid rgba(148, 163, 184, 0.25);
			gap: 0.75rem;
		}

		.nav-menu.is-open {
			display: flex;
		}

		.internal-links {
			flex-direction: column;
			align-items: stretch;
			gap: 0.15rem;
		}

		.internal-links :global(a) {
			padding: 0.7rem 0.75rem;
			border-bottom: none;
			border-left: 3px solid transparent;
			border-radius: 8px;
			font-size: 1rem;
			gap: 0.6rem;
		}

		.internal-links :global(a:hover) {
			background: rgba(255, 107, 53, 0.06);
		}

		.internal-links :global(a.active) {
			border-bottom-color: transparent;
			border-left-color: var(--accent);
			background: rgba(255, 107, 53, 0.08);
		}

		.mobile-only-label {
			display: inline;
		}

		.social-links {
			justify-content: flex-start;
			padding: 0.65rem 0.5rem 0;
			border-top: 1px solid rgba(148, 163, 184, 0.2);
			gap: 0.5rem;
		}
	}

	/* Logo Enlargement Modal Styles */
	.logo-modal {
		border: none;
		border-radius: 12px;
		padding: 0;
		background: transparent;
		box-shadow:
			0 20px 25px -5px rgba(0, 0, 0, 0.1),
			0 10px 10px -5px rgba(0, 0, 0, 0.04);
		max-width: 90vw;
		max-height: 90vh;
		overflow: visible;
	}

	.logo-modal::backdrop {
		background: rgba(0, 0, 0, 0.5);
		backdrop-filter: blur(4px);
	}

	.modal-content {
		background: white;
		padding: 2rem;
		border-radius: 12px;
		display: flex;
		justify-content: center;
		align-items: center;
	}

	.large-logo {
		width: auto;
		height: auto;
		max-width: 80vw;
		max-height: 80vh;
		min-width: 260px;
	}

	.close-container {
		position: absolute;
		top: -15px;
		right: -15px;
		z-index: 10;
	}

	.close-btn {
		background: var(--accent);
		color: white;
		border: 2px solid white;
		border-radius: 50%;
		width: 36px;
		height: 36px;
		font-size: 18px;
		font-weight: bold;
		cursor: pointer;
		display: flex;
		align-items: center;
		justify-content: center;
		box-shadow: 0 2px 5px rgba(0, 0, 0, 0.2);
		transition: background-color 0.2s;
	}

	.close-btn:hover {
		background-color: var(--accent-dark, #d24e00);
	}

	@media (max-width: 768px) {
		.modal-content {
			padding: 1rem;
		}
	}

	/* MTA Bullet Styles */
	.mta-bullet {
		position: relative;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 28px;
		height: 28px;
		border-radius: 50%;
		font-family: Helvetica, Arial, sans-serif;
		font-weight: bold;
		font-size: 16px;
		line-height: 1;
		overflow: visible;
		flex-shrink: 0;
	}

	.q-bullet {
		background-color: #fccc0a;
		color: black;
		transition: box-shadow 0.25s ease, transform 0.25s ease;
	}

	.q-santa-cap {
		display: none;
		position: absolute;
		top: -10px;
		right: -11px;
		width: 24px;
		height: 20px;
		pointer-events: none;
		transform: rotate(12deg);
		filter: drop-shadow(0 1px 2px rgba(15, 23, 42, 0.35));
		z-index: 3;
	}

	:global(html.holiday-mode) .q-bullet {
		box-shadow:
			0 0 0 2px #1b5e20,
			0 2px 8px rgba(217, 4, 41, 0.35);
	}

	:global(html.holiday-mode) .q-santa-cap {
		display: block;
	}

	:global(html.holiday-mode) .internal-links :global(a.active) {
		border-bottom-color: #2e8b57;
		border-left-color: #2e8b57;
	}

	/* Holiday Mode Twinkling Fairy Lights Strand */
	.holiday-fairy-lights {
		display: none;
		position: absolute;
		left: 0;
		right: 0;
		bottom: -7px;
		height: 12px;
		justify-content: space-around;
		align-items: flex-start;
		padding: 0 1.25rem;
		pointer-events: none;
		z-index: 30;
		border-top: 1.5px solid rgba(27, 67, 50, 0.45);
	}

	:global(html.holiday-mode) .holiday-fairy-lights {
		display: flex;
	}

	.light-bulb {
		position: relative;
		width: 7px;
		height: 10px;
		border-radius: 50% 50% 55% 55%;
		margin-top: 1px;
		transform-origin: top center;
	}

	.light-bulb::before {
		content: "";
		position: absolute;
		top: -2px;
		left: 1.5px;
		width: 4px;
		height: 3px;
