---

---

<button
    id="holiday-toggle"
    class="holiday-toggle"
    aria-label="Toggle Holiday Mode"
    hidden
>
    🎄 Holiday Mode
</button>
<a
    id="holiday-tree-link"
    href="/interactive/holiday-tree"
    class="holiday-tree-link"
    title="Decorate the Next Val Data Holiday Tree"
    hidden
>
    🎨 Decorate Tree
</a>

<!-- Fixed viewport bottom snowdrift & corner silhouettes in Holiday Mode -->
<div class="holiday-snowdrift-overlay" aria-hidden="true">
    <svg
        class="snowdrift-waves"
        viewBox="0 0 1440 36"
        preserveAspectRatio="none"
        xmlns="http://www.w3.org/2000/svg"
    >
        <defs>
            <linearGradient id="snowdrift-back-grad" x1="0" y1="0" x2="0" y2="1">
                <stop offset="0%" stop-color="#dbeafe" stop-opacity="0.92" />
                <stop offset="100%" stop-color="#bfdbfe" stop-opacity="0.98" />
            </linearGradient>
            <linearGradient id="snowdrift-front-grad" x1="0" y1="0" x2="0" y2="1">
                <stop offset="0%" stop-color="#ffffff" />
                <stop offset="65%" stop-color="#f8fafc" />
                <stop offset="100%" stop-color="#e2e8f0" />
            </linearGradient>
        </defs>
        <!-- Back frost drift wave -->
        <path
            d="M0 16 C180 6, 340 24, 540 15 C740 6, 920 23, 1140 13 C1280 7, 1380 15, 1440 10 L1440 36 L0 36 Z"
            fill="url(#snowdrift-back-grad)"
        />
        <!-- Front crisp snowbank wave -->
        <path
            d="M0 20 C150 12, 320 27, 510 21 C710 14, 890 28, 1090 19 C1250 12, 1360 22, 1440 16 L1440 36 L0 36 Z"
            fill="url(#snowdrift-front-grad)"
        />
        <!-- Subtle icy top highlight -->
        <path
            d="M0 20 C150 12, 320 27, 510 21 C710 14, 890 28, 1090 19 C1250 12, 1360 22, 1440 16"
            fill="none"
            stroke="#bae6fd"
            stroke-width="1.2"
            stroke-opacity="0.85"
        />
    </svg>

    <!-- Bottom-left miniature snow-dusted pine tree -->
    <svg
        class="snowdrift-corner-pine"
        viewBox="0 0 64 76"
        fill="none"
        xmlns="http://www.w3.org/2000/svg"
    >
        <!-- Trunk -->
        <rect x="28" y="60" width="8" height="12" rx="1.5" fill="#5c3a21" />
        <!-- Bottom tier -->
        <polygon points="32,30 8,62 56,62" fill="#1b4332" />
        <path d="M22 48 Q32 53 42 48 L48 56 Q32 61 16 56 Z" fill="#f8fafc" opacity="0.85" />
        <!-- Middle tier -->
        <polygon points="32,18 13,46 51,46" fill="#2d6a4f" />
        <path d="M18 42 Q32 46 46 42" stroke="#ffffff" stroke-width="2.5" stroke-linecap="round" />
        <!-- Top tier -->
        <polygon points="32,8 18,31 46,31" fill="#2e8b57" />
        <path d="M21 28 Q32 31 43 28" stroke="#ffffff" stroke-width="2.2" stroke-linecap="round" />
        <!-- Tiny gold star -->
        <circle cx="32" cy="7" r="3.5" fill="#facc15" />
        <!-- Tiny ornaments -->
        <circle cx="25" cy="39" r="2" fill="#e11d48" />
        <circle cx="38" cy="51" r="2.2" fill="#facc15" />
        <circle cx="24" cy="54" r="2" fill="#38bdf8" />
    </svg>

    <!-- Bottom-right miniature snowman & pine accent -->
    <svg
        class="snowdrift-corner-snowman"
        viewBox="0 0 76 76"
        fill="none"
        xmlns="http://www.w3.org/2000/svg"
    >
        <!-- Small background pine silhouette -->
        <polygon points="56,22 42,64 70,64" fill="#1b4332" opacity="0.92" />
        <polygon points="56,12 45,44 67,44" fill="#2d6a4f" opacity="0.95" />
        <path d="M47 41 Q56 44 65 41" stroke="#f8fafc" stroke-width="2" stroke-linecap="round" />
        <!-- Snowman base & middle -->
        <circle cx="30" cy="55" r="13" fill="#ffffff" stroke="#cbd5e1" stroke-width="1.2" />
        <circle cx="30" cy="37" r="9.5" fill="#ffffff" stroke="#cbd5e1" stroke-width="1.2" />
        <!-- Coal buttons -->
        <circle cx="30" cy="49" r="1.4" fill="#1e293b" />
        <circle cx="30" cy="55" r="1.4" fill="#1e293b" />
        <!-- Eyes & carrot nose -->
        <circle cx="27" cy="35" r="1.3" fill="#0f172a" />
        <circle cx="33" cy="35" r="1.3" fill="#0f172a" />
        <polygon points="30,36.5 39,38.2 30,39.5" fill="#f97316" />
        <!-- Cozy cranberry & gold scarf -->
        <path
            d="M21 43 Q30 46.5 39 43"
            stroke="#e11d48"
            stroke-width="4"
            stroke-linecap="round"
        />
        <path
            d="M34 44 L36 53"
            stroke="#e11d48"
            stroke-width="3.5"
            stroke-linecap="round"
        />
        <circle cx="35.5" cy="50" r="1.1" fill="#facc15" />
        <!-- Top hat -->
        <rect x="20" y="26" width="20" height="2.8" rx="1.4" fill="#1e293b" />
        <rect x="23.5" y="17" width="13" height="10" rx="1.5" fill="#0f172a" />
        <rect x="23.5" y="24" width="13" height="2.2" fill="#d4af37" />
    </svg>
</div>

<script>
    function initHolidayMode() {
        const toggleBtn = document.getElementById("holiday-toggle");
        if (!toggleBtn) return;

        const now = new Date();
        const currentYear = now.getFullYear();
        const start = new Date(currentYear, 11, 10); // Dec 10
        const end = new Date(currentYear, 11, 31, 23, 59, 59); // Dec 31 end of day

        const isLocalDev =
            window.location.hostname === "localhost" ||
            window.location.hostname === "127.0.0.1";
        const urlParams = new URLSearchParams(window.location.search);
        const forceHolidayParam =
            urlParams.get("holiday") === "true" ||
            urlParams.get("holiday") === "1";

        // Check if within date range (Dec 10 - Dec 31), or running on local dev / preview param
        if ((now >= start && now <= end) || isLocalDev || forceHolidayParam) {
            toggleBtn.hidden = false;

            // On local dev or ?holiday=true, auto-enable Holiday Mode on initial load
            if ((isLocalDev || forceHolidayParam) && !sessionStorage.getItem("holiday-dev-initialized")) {
                sessionStorage.setItem("holiday-dev-initialized", "true");
                localStorage.setItem("holiday-mode", "true");
            }

            // Check stored preference
            const isHolidayMode =
                localStorage.getItem("holiday-mode") === "true";
            if (isHolidayMode) {
                enableHolidayMode();
            }

            toggleBtn.onclick = () => {
                const isActive =
                    document.documentElement.classList.contains("holiday-mode");
                if (isActive) {
                    disableHolidayMode();
                } else {
                    enableHolidayMode();
                }
            };
        } else {
            toggleBtn.hidden = true;
            document.documentElement.classList.remove("holiday-mode");
        }

        function enableHolidayMode() {
            document.documentElement.classList.add("holiday-mode");
            localStorage.setItem("holiday-mode", "true");
            toggleBtn.classList.add("active");
            const treeLink = document.getElementById("holiday-tree-link");
            if (treeLink) treeLink.hidden = false;
            startSnow();
        }

        function disableHolidayMode() {
            document.documentElement.classList.remove("holiday-mode");
            localStorage.setItem("holiday-mode", "false");
            toggleBtn.classList.remove("active");
            const treeLink = document.getElementById("holiday-tree-link");
            if (treeLink) treeLink.hidden = true;
        }

        function startSnow() {
            // Avoid duplicate snow if already snowing
            if (document.getElementById("snow-container")) return;

            const snowContainer = document.createElement("div");
            snowContainer.id = "snow-container";
            Object.assign(snowContainer.style, {
                position: "fixed",
                top: "0",
                left: "0",
                width: "100%",
                height: "100%",
                pointerEvents: "none",
                zIndex: "9999",
                overflow: "hidden",
            });

            // Add keyframes if not exists
            if (!document.getElementById("snow-keyframes")) {
                const style = document.createElement("style");
                style.id = "snow-keyframes";
                style.textContent = `
                    @keyframes fall {
                        0% { transform: translateY(-10vh) rotate(0deg); opacity: 1; }
                        100% { transform: translateY(100vh) rotate(360deg); opacity: 0.7; }
                    }
                `;
                document.head.appendChild(style);
            }

            const numberOfSnowflakes = 50;
            for (let i = 0; i < numberOfSnowflakes; i++) {
                const snowflake = document.createElement("div");
                snowflake.textContent = "❄";
                Object.assign(snowflake.style, {
                    position: "absolute",
                    top: "-20px",
                    left: Math.random() * 100 + "%",
                    opacity: Math.random(),
                    fontSize: Math.random() * 20 + 10 + "px",
                    color: "#aaddff", // Light blue, visible on generic backgrounds
                    textShadow: "0 0 2px rgba(0,0,0,0.3)",
                    animation: `fall ${Math.random() * 3 + 2}s linear infinite`,
                });
                snowContainer.appendChild(snowflake);
            }

            document.body.appendChild(snowContainer);

            // Remove after 5 seconds (5000ms)
            setTimeout(() => {
                snowContainer.style.transition = "opacity 1s";
                snowContainer.style.opacity = "0";
                setTimeout(() => {
                    snowContainer.remove();
                }, 1000);
            }, 5000);
        }
    }

    // Run on load
    initHolidayMode();

    // Re-run on view transitions if enabled
    document.addEventListener("astro:page-load", initHolidayMode);
</script>

<style is:global>
    /* Toggle Button Styles */
    .holiday-toggle {
        background: transparent;
        border: none;
        padding: 0.5em 1em;
        font-size: 0.9em;
        cursor: pointer;
        font-family: inherit;
        color: inherit;
        transition: all 0.2s;
        margin-left: 1em;
    }

    .holiday-toggle:hover {
        background: rgba(46, 139, 87, 0.1); /* Subtle green tint */
        border-color: #2e8b57;
        color: #2e8b57;
    }

    .holiday-toggle.active {
        background: #2e8b57; /* Forest Green for a more classic look */
        color: white;
        border-color: #2e8b57;
    }

    .holiday-tree-link {
        display: inline-flex;
        align-items: center;
        padding: 0.45em 0.85em;
        margin-left: 0.4em;
        font-size: 0.82em;
        font-weight: 700;
        color: #1b4332 !important;
        background: linear-gradient(135deg, #fef08a 0%, #fde047 100%);
        border: 1px solid #d4af37 !important;
        border-radius: 9999px;
        text-decoration: none;
        box-shadow: 0 2px 8px rgba(212, 175, 55, 0.28);
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

    .holiday-tree-link[hidden] {
        display: none !important;
    }

    .holiday-tree-link:hover {
        transform: translateY(-1px);
        box-shadow: 0 4px 12px rgba(212, 175, 55, 0.45);
    }

    /* Viewport Bottom Snowy Ground Drift & Corner Silhouettes */
    .holiday-snowdrift-overlay {
        display: none;
        position: fixed;
        left: 0;
        right: 0;
        bottom: 0;
        height: 22px;
        pointer-events: none;
        z-index: 9990;
        overflow: visible;
    }

    html.holiday-mode .holiday-snowdrift-overlay {
        display: block;
    }

    .snowdrift-waves {
        position: absolute;
        left: 0;
        bottom: 0;
        width: 100%;
        height: 22px;
        display: block;
        filter: drop-shadow(0 -2px 5px rgba(148, 163, 184, 0.28));
    }

    .snowdrift-corner-pine {
        position: absolute;
        left: 14px;
        bottom: 2px;
        width: 44px;
        height: 52px;
        filter: drop-shadow(0 2px 4px rgba(15, 23, 42, 0.18));
    }

    .snowdrift-corner-snowman {
        position: absolute;
        right: 16px;
        bottom: 2px;
        width: 52px;
        height: 52px;
        filter: drop-shadow(0 2px 4px rgba(15, 23, 42, 0.18));
    }

    @media (max-width: 640px) {
        .holiday-snowdrift-overlay,
        .snowdrift-waves {
            height: 16px;
        }
        .snowdrift-corner-pine {
            left: 6px;
            width: 32px;
            height: 38px;
        }
        .snowdrift-corner-snowman {
            right: 8px;
            width: 38px;
            height: 38px;
        }
    }
</style>
