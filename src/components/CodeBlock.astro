---
interface Props {
  code: string;
  lang?: string;
  filename?: string;
}

const { code, lang = 'plaintext', filename } = Astro.props;
---

<div class="code-block-container" style="margin: 1.5rem 0; border-radius: 8px; overflow: hidden; border: 1px solid #e2e8f0; background-color: #f8fafc;">
  {filename && (
    <div class="code-block-header" style="padding: 0.5rem 1rem; background-color: #edf2f7; border-bottom: 1px solid #e2e8f0; font-family: monospace; font-size: 0.8rem; color: #4a5568;">
      {filename}
    </div>
  )}
  <pre style="margin: 0; padding: 1rem; overflow-x: auto; font-family: monospace; font-size: 0.9rem; background: none;"><code class={`language-${lang}`}>{code}</code></pre>
</div>
