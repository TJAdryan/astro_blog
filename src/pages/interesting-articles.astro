---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="My Reading List" description="A curated archive of seminal research papers, academic literature, books, and reference documentation that I read and study.">
  <section>
    <div class="text-left mb-8">
      <h1 class="text-4xl font-extrabold tracking-tight mb-2">My Reading List</h1>
      <p class="text-lg text-gray-600 dark:text-gray-400">
        A curated archive of seminal research papers, academic literature, books, and reference documentation that I read and study.
      </p>
    </div>

    <!-- Search Bar -->
    <div class="search-container">
      <input
        type="text"
        id="reading-search"
        class="search-input"
        placeholder="Search papers, authors, categories..."
        autocomplete="off"
      />
    </div>

    <!-- Category Filter Pills -->
    <div class="categories-wrapper" id="categories-filter">
      <!-- Will be dynamically populated with category pills -->
    </div>

    <!-- Articles List -->
    <ul id="articles-grid">
      <!-- All articles will be rendered dynamically here -->
    </ul>
    <div id="no-results" class="no-results">
      No reading list items match your search or filter criteria.
    </div>
  </section>
</BaseLayout>

<script is:inline>
  document.addEventListener('DOMContentLoaded', function() {
    let allArticles = [];
    let selectedCategory = 'All';
    let searchQuery = '';

    const grid = document.getElementById('articles-grid');
    const filterContainer = document.getElementById('categories-filter');
    const searchInput = document.getElementById('reading-search');
    const noResults = document.getElementById('no-results');

    fetch('/data/articles.json')
      .then(res => res.json())
      .then(articles => {
        allArticles = articles;
        
        // 1. Extract unique categories (areas)
        const categories = new Set();
        articles.forEach(art => {
          if (art.area) categories.add(art.area);
        });

        // 2. Render filter pills
        renderFilterPills(Array.from(categories).sort());

        // 3. Initial render
        renderArticles();

        // 4. Setup search event listener
        if (searchInput) {
          searchInput.addEventListener('input', (e) => {
            searchQuery = e.target.value.toLowerCase();
            renderArticles();
          });
        }
      })
      .catch(err => {
        if (grid) {
          grid.innerHTML = '<p class="text-gray-500 text-center py-8">Unable to load the reading list.</p>';
        }
        console.error('Failed to load articles.json', err);
      });

    function getDomain(urlStr) {
      try {
        const hostname = new URL(urlStr).hostname;
        return hostname.replace(/^www\./, '');
      } catch (e) {
        return 'external resource';
      }
    }

    function getCategoryClass(area) {
      const norm = (area || '').toLowerCase();
      if (norm.includes('ai') || norm.includes('machine learning')) return 'badge-ai';
      if (norm.includes('database')) return 'badge-db';
      if (norm.includes('distributed')) return 'badge-dist';
      if (norm.includes('social')) return 'badge-social';
      if (norm.includes('economics')) return 'badge-econ';
      if (norm.includes('genomics') || norm.includes('crispr')) return 'badge-crispr';
      if (norm.includes('software') || norm.includes('engineering')) return 'badge-se';
      return 'badge-default';
    }

    function renderFilterPills(categoriesList) {
      if (!filterContainer) return;
      filterContainer.innerHTML = '';

      // Add 'All' pill
      const allPill = document.createElement('button');
      allPill.className = 'category-pill active';
      allPill.textContent = 'All';
      allPill.addEventListener('click', () => selectCategory('All', allPill));
      filterContainer.appendChild(allPill);

      categoriesList.forEach(cat => {
        const pill = document.createElement('button');
        pill.className = 'category-pill';
        pill.textContent = cat;
        pill.addEventListener('click', () => selectCategory(cat, pill));
        filterContainer.appendChild(pill);
      });
    }

    function selectCategory(cat, pillElement) {
      selectedCategory = cat;
      // Update active state in UI
      const pills = filterContainer.querySelectorAll('.category-pill');
      pills.forEach(p => p.classList.remove('active'));
      pillElement.classList.add('active');

      renderArticles();
    }

    function renderArticles() {
      if (!grid) return;
      grid.innerHTML = '';

      // Filter articles based on selectedCategory and searchQuery
      const filtered = allArticles.filter(art => {
        const matchCategory = selectedCategory === 'All' || art.area === selectedCategory;
        
        const textToSearch = [
          art.title,
          art.author,
          art.area,
          getDomain(art.url)
        ].join(' ').toLowerCase();
        
        const matchSearch = textToSearch.includes(searchQuery);

        return matchCategory && matchSearch;
      });

      if (filtered.length === 0) {
        if (noResults) noResults.style.display = 'block';
        return;
      }

      if (noResults) noResults.style.display = 'none';

      filtered.forEach((art, index) => {
        const card = document.createElement('li');
        card.className = 'post-item';
        card.style.animationDelay = `${index * 0.03}s`;

        const badgeClass = getCategoryClass(art.area);

        card.innerHTML = `
          <a href="${art.url}" target="_blank" rel="noopener">
            <div class="card-meta">
              <span class="area-badge ${badgeClass}">${art.area || 'Resource'}</span>
              <span class="domain-badge">
                <svg style="width: 14px; height: 14px; margin-right: 4px; display: inline-block;" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1"></path>
                </svg>
                ${getDomain(art.url)}
              </span>
            </div>
            <h4 class="title">
              ${art.title}
              <svg style="width: 14px; height: 14px; margin-left: 4px; display: inline-block;" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path>
              </svg>
            </h4>
            <p class="date">By ${art.author || 'Unknown'}</p>
          </a>
        `;

        grid.appendChild(card);
      });
    }
  });
</script>

<style>
  /* Search Bar Styles */
  .search-container {
    margin-bottom: 2rem;
    position: relative;
  }

  .search-input {
    width: 100%;
    padding: 1rem 1.5rem;
    font-size: 1.1rem;
    border: 2px solid transparent; /* Prepare for gradient border */
    border-radius: 50px;
    background:
      linear-gradient(#fff, #fff) padding-box,
      linear-gradient(to right, #ff6b35, #ff9f43) border-box;
    box-shadow: 0 4px 15px rgba(255, 107, 53, 0.1);
    transition: all 0.3s ease;
    outline: none;
    color: var(--black);
  }

  .search-input:focus {
    box-shadow: 0 8px 25px rgba(255, 107, 53, 0.25);
    transform: translateY(-2px);
  }

  .search-input::placeholder {
    color: #999;
  }

  @media (prefers-color-scheme: dark) {
    .search-input {
      background:
        linear-gradient(#1e293b, #1e293b) padding-box,
        linear-gradient(to right, #ff6b35, #ff9f43) border-box;
      color: #f8fafc;
    }
    .search-input::placeholder {
      color: #64748b;
    }
  }

  /* Category Filter Pills */
  .categories-wrapper {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 2rem;
  }

  .category-pill {
    background: rgba(255, 255, 255, 0.8);
    color: #475569;
    border: 1px solid rgba(255, 107, 53, 0.15);
    border-radius: 50px;
    padding: 0.4rem 1rem;
    font-size: 0.85rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .category-pill:hover {
    background: #e2e8f0;
    color: #1e293b;
    transform: translateY(-1px);
  }

  .category-pill.active {
    background: var(--accent);
    color: white;
    border-color: var(--accent);
    box-shadow: 0 4px 10px rgba(255, 107, 53, 0.25);
  }

  @media (prefers-color-scheme: dark) {
    .category-pill {
      background: rgba(30, 41, 59, 0.8);
      color: #cbd5e1;
      border-color: rgba(255, 255, 255, 0.05);
    }
    .category-pill:hover {
      background: #334155;
      color: #f8fafc;
    }
    .category-pill.active {
      background: var(--accent);
      color: white;
      border-color: var(--accent);
    }
  }

  /* Articles Grid / Flex */
  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 2rem;
    list-style-type: none;
    margin: 0;
    padding: 0;
  }

  ul li {
    width: calc(50% - 1rem);
    opacity: 0;
    animation: slideIn 0.5s ease-out forwards;
  }

  @keyframes slideIn {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  ul li * {
    text-decoration: none;
    transition: 0.2s ease;
  }

  ul li a {
    display: block;
    padding: 1.5rem;
    background: rgba(255, 255, 255, 0.8);
    border-radius: 12px;
    border: 1px solid rgba(255, 107, 53, 0.1);
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
    transition: all 0.3s cubic-bezier(0.25, 0.8, 0.25, 1);
    height: 100%;
    position: relative;
    overflow: hidden;
  }

  /* Shine effect on hover */
  ul li a::before {
    content: "";
    position: absolute;
    top: 0;
    left: -100%;
    width: 100%;
    height: 100%;
    background: linear-gradient(
      90deg,
      transparent,
      rgba(255, 255, 255, 0.5),
      transparent
    );
    transition: 0.5s;
    pointer-events: none;
  }

  ul li a:hover::before {
    left: 100%;
  }

  ul li a:hover {
    transform: translateY(-5px);
    box-shadow: 0 12px 30px rgba(255, 107, 53, 0.25);
    border-color: rgba(255, 107, 53, 0.4);
  }

  .title {
    margin: 0 0 0.5rem 0;
    color: rgb(var(--black));
    line-height: 1.35;
    font-size: 1.3rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    display: inline-flex;
    align-items: center;
  }

  .date {
    margin: 0;
    color: rgb(var(--gray));
    font-style: italic;
    font-size: 0.92rem;
  }

  ul li a:hover h4,
  ul li a:hover .date {
    color: rgb(var(--accent));
  }

  @media (prefers-color-scheme: dark) {
    ul li a {
      background: rgba(30, 41, 59, 0.8);
      border-color: rgba(255, 107, 53, 0.15);
    }
    ul li a:hover {
      background: rgba(30, 41, 59, 0.95);
      border-color: rgba(255, 107, 53, 0.5);
    }
  }

  /* Meta styles inside card */
  .card-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.8rem;
    margin-bottom: 0.75rem;
  }

  .area-badge {
    padding: 0.2rem 0.6rem;
    border-radius: 4px;
    font-weight: 700;
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.02em;
  }

  /* Specific Badge Colors */
  .badge-ai { background-color: #f5f3ff; color: #7c3aed; border: 1px solid #ddd6fe; }
  .badge-db { background-color: #eff6ff; color: #2563eb; border: 1px solid #bfdbfe; }
  .badge-dist { background-color: #e0e7ff; color: #4f46e5; border: 1px solid #c7d2fe; }
  .badge-social { background-color: #fdf2f8; color: #db2777; border: 1px solid #fbcfe8; }
  .badge-econ { background-color: #ecfdf5; color: #059669; border: 1px solid #a7f3d0; }
  .badge-crispr { background-color: #fff1f2; color: #e11d48; border: 1px solid #fecdd3; }
  .badge-se { background-color: #fffbeb; color: #d97706; border: 1px solid #fde68a; }
  .badge-default { background-color: #f8fafc; color: #475569; border: 1px solid #e2e8f0; }

  @media (prefers-color-scheme: dark) {
    .badge-ai { background-color: rgba(124, 58, 237, 0.15); color: #c084fc; border-color: rgba(124, 58, 237, 0.3); }
    .badge-db { background-color: rgba(37, 99, 235, 0.15); color: #93c5fd; border-color: rgba(37, 99, 235, 0.3); }
    .badge-dist { background-color: rgba(79, 70, 229, 0.15); color: #a5b4fc; border-color: rgba(79, 70, 229, 0.3); }
    .badge-social { background-color: rgba(219, 39, 119, 0.15); color: #f472b6; border-color: rgba(219, 39, 119, 0.3); }
    .badge-econ { background-color: rgba(5, 150, 105, 0.15); color: #6ee7b7; border-color: rgba(5, 150, 105, 0.3); }
    .badge-crispr { background-color: rgba(225, 29, 72, 0.15); color: #fda4af; border-color: rgba(225, 29, 72, 0.3); }
    .badge-se { background-color: rgba(217, 119, 6, 0.15); color: #fcd34d; border-color: rgba(217, 119, 6, 0.3); }
    .badge-default { background-color: rgba(71, 85, 105, 0.15); color: #cbd5e1; border-color: rgba(71, 85, 105, 0.3); }
  }

  .domain-badge {
    display: inline-flex;
    align-items: center;
    color: #64748b;
    font-weight: 500;
  }

  @media (prefers-color-scheme: dark) {
    .domain-badge {
      color: #94a3b8;
    }
  }

  .no-results {
    text-align: center;
    padding: 2rem;
    color: var(--gray);
    font-size: 1.2rem;
    display: none;
    width: 100%;
  }

  @media (max-width: 720px) {
    ul {
      gap: 1rem;
    }
    ul li {
      width: 100%;
    }
  }
</style>